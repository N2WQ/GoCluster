package main

import (
	"testing"
	"time"

	"dxcluster/spot"
)

func TestV16DecayChronologicalOutput(t *testing.T) {
	start := time.Unix(10000,0).UTC()
	window := 5*time.Minute
	r,key := replayTemporalFreshRunner(t,replayTemporalFreshConfig(),start,window)
	old,ok := r.resolver.Lookup(key)
	if !ok || old.Winner != "K1ABC" || old.WinnerSupport != 3 {t.Fatal(old)}
	now := start.Add(180*time.Second)
	for _, rx := range []string{"N0AAA","N0BBB"} {
		if !r.resolver.Enqueue(spot.ResolverEvidence{ObservedAt:now, Key:key, DXCall:"K1ABE",
			Spotter:rx, FrequencyKHz:14020, RecencyWindow:window}) {t.Fatal("queue")}
	}
	r.driver.Step(now)
	r.driver.Sweep(now.Add(time.Millisecond))
	published,ok := r.resolver.Lookup(key)
	if !ok || published.Winner!="K1ABE" || published.WinnerSupport!=2 || published.TotalReporters!=4 {
		t.Fatalf("late owner publication: %+v",published)
	}
	replayTemporalFreshOrdinaryControl(t,r,key,replayTemporalFreshSpot("K1ABF",now),now,"K1ABE")
	later,ok := r.resolver.LookupEligible(key,now.Add(60*time.Second))
	if !ok || later.Winner!="K1ABE" || later.WinnerWeightedSupportMilli>=published.WinnerWeightedSupportMilli ||
		later.TotalWeightedSupportMilli>=published.TotalWeightedSupportMilli || later.TotalReporters!=4 {
		t.Fatalf("release failed to reprice still-eligible rows: %+v",later)
	}
	expired,ok := r.resolver.LookupEligible(key,start.Add(window+time.Second))
	if !ok || expired.TotalReporters!=2 || len(expired.CandidateRanks)!=1 || expired.CandidateRanks[0].Call!="K1ABE" {
		t.Fatalf("expired ghost was retained: %+v", expired)
	}
}

func TestV16DecayImmediateAndHoldEntryUseEventClock(t *testing.T) {
	start := time.Unix(10000,0).UTC()
	window := 5*time.Minute
	cfg := replayTemporalFreshConfig()
	cfg.ResolverNeighborhoodEnabled = true
	cfg.ResolverNeighborhoodBucketRadius = 1
	r,key := replayTemporalFreshRunner(t,cfg,start,window)
	inside := start.Add(window)
	after := inside.Add(time.Second)
	s := replayTemporalFreshSpot("K1ABF",start)
	replayTemporalFreshOrdinaryControl(t,r,key,s,inside,"K1ABC")

	// A quiet key has not been swept. Its unexpired publication still authorizes
	// the old winner; every CW event-clock lookup (including adjoining slots)
	// must discard those votes one second beyond the closed eligibility window.
	published,_ := r.resolver.Lookup(key)
	if published.Winner != "K1ABC" || published.TotalReporters!=4 { t.Fatal(published) }
	adjacent := key
	adjacent.Bucket++
	for _, entry := range []spot.ResolverSignalKey{key, adjacent} {
		held := r.selectTemporalInitial(s,entry,"K1ABF",after)
		if held.Snapshot.TotalReporters!=0 || held.Snapshot.Winner!="" {t.Fatal("hold entry used stale population",held)}
		var capture studyDiagnosticSelectorCall
		out := maybeApplyResolverCorrectionReplayDiagnosticCore(s.Clone(),r.resolver,spot.ResolverEvidence{Key:entry},
			true,cfg,nil,nil,nil,nil,after,nil,&capture,nil)
		if capture.Err!=nil || !capture.Called || capture.Data.OwnerClock || !capture.Data.RequestedAt.Equal(after) ||
			out.Applied || out.Selection.Snapshot.TotalReporters!=0 {t.Fatal("immediate stale population",out,capture.Err)}
		hits := 0
		for _, read := range capture.Data.Reads {
			if read.Present {
				hits++
				if len(read.RawRows)>0 {t.Fatal("stale source",read)}
			}
		}
		if hits!=1 {t.Fatalf("consulted %d existing keys, expected 1",hits)}
	}
	if !v16VoteClock(spot.NewResolverSignalKey(14020,"20m","RTTY",500), after).IsZero() {t.Fatal("RTTY clock changed")}
}

func TestV16DecayLatestVotePerNativeReceiver(t *testing.T) {
	start := time.Unix(10000,0).UTC()
	window := 5*time.Minute
	r,key := replayTemporalFreshRunner(t,replayTemporalFreshConfig(),start,window)
	neighbor := spot.NewResolverSignalKey(14020.5,"20m","CW",500)
	for _, input := range []struct{ age time.Duration; key spot.ResolverSignalKey; frequency float64 }{
		{10*time.Second,key,14020}, {20*time.Second,key,14020},
		{30*time.Second,neighbor,14020.5},
	} {
		e := spot.ResolverEvidence{ObservedAt:start.Add(input.age),Key:input.key,DXCall:"K1ABC",
			Spotter:"N0AAA",FrequencyKHz:input.frequency,RecencyWindow:window}
		if !r.resolver.Enqueue(e) {t.Fatal("queue")}
		r.driver.Step(e.ObservedAt)
		r.driver.Sweep(e.ObservedAt.Add(time.Millisecond))
	}
	at := start.Add(60*time.Second)
	left,_ := r.resolver.LookupEligible(key,at)
	right,_ := r.resolver.LookupEligible(neighbor,at)
	joined := spot.MergeResolverEvidenceViews(left.ReceiverEvidence(),right.ReceiverEvidence())
	count, milli,_ := joined.ReceiverTotals()
	latest := 0
	joined.RangeCanonical(func(identity, display string,row spot.ResolverReceiverObservation) bool {
		if identity=="K1ABC" && row.Receiver=="N0AAA" {
			latest++
			if !row.ObservedAt.Equal(start.Add(30*time.Second)) || row.WeightMilli!=right.WinnerWeightedSupportMilli {
				t.Fatal("duplicate did not retain the latest receiver vote",row,right)
			}
		}
		return true
	})
	if latest!=1 || count!=4 || milli!=left.TotalWeightedSupportMilli-left.CandidateRanks[0].WeightedSupportMilli+
		joined.CanonicalSupport(1)[0].WeightedSupportMilli {
		t.Fatalf("duplicate inflated weighted population: count=%d milli=%d latest=%d",count,milli,latest)
	}
}
