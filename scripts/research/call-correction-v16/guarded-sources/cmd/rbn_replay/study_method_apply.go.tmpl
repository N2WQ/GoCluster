func (r *replayRunner) methodEnabled() bool { return r.method != nil && r.method.prepared.Plan.Enabled }

// saved is supplied only for a held Apply whose existing release guards passed.
// Fallback is a new current resolver decision. Abstain/bypass/overflow never
// reach this function through the experimental route.
func (r *replayRunner) applyMethodRescue(s *spot.Spot, evidence spot.ResolverEvidence, hasEvidence bool, now time.Time,
	outcome replayResolverApplyOutcome, permitted string, saved *correctionflow.FrequencyLifecycleVector) replayResolverApplyOutcome {
	if !r.methodEnabled() || s == nil || !hasEvidence || !r.cfg.CallCorrection.Enabled || evidence.Key.Mode != "CW" ||
		outcome.Applied || outcome.Suppress || outcome.replacementRejected {
		return outcome
	}
	if replayCrowdingNarrow && (!outcome.GateEvaluated || outcome.Gate.Reason != "max_edit_distance") {
		return outcome
	}
	subject := normalizedDXCall(s)
	candidate := r.method.prepared.Candidate
	maxDistance := candidate.CWDistances[len(candidate.CWDistances)-1]
	sources := correctionflow.ReadFrequencySources(r.resolver, evidence.Key, r.cfg.CallCorrection, now)
	receipt := studyMethodReceipt{ObservedAt: evidence.ObservedAt, DecisionAt: now, CandidateID: candidate.ID, Subject: subject,
		PermittedTemporalIdentity: permitted, LifecycleCurrent: true, OrdinaryGate: outcome.Gate}
	if r.study != nil {
		if pending := r.study.pending[s]; pending != nil {
			receipt.RawID = pending.RawID
		}
	}
	if saved != nil && *saved != correctionflow.FrequencySourceLifecycles(sources) {
		receipt.LifecycleCurrent = false
		receipt.Assessment.Reason = "lifecycle_changed"
	} else {
		options := correctionflow.FrequencyProposalOptions{GapHz: candidate.GapHz, MaxWitnessSeparation: time.Duration(candidate.MaxWitnessSeconds) * time.Second, MaxDistance: maxDistance}
		compatibility := r.method.prepared.Plan.SchemaVersion == 2 && candidate.Ranking == "receiver_compatibility"
		var proposals []correctionflow.FrequencyProposal
		if compatibility {
			b := correctionflow.AssessReceiverCompatibilityProposals(evidence.Key, subject, s.Frequency, outcome.Selection, sources, r.cfg.CallCorrection, options, r.method.prepared.Model)
			receipt.Assessment, receipt.SelectiveDeclines = b.FrequencyAssessment, b.Declines
			receipt.Compatibility = &studyCompatibilityReceipt{Available: b.Available, Reason: b.CompatibilityReason,
				Hypotheses: b.Hypotheses, Selected: b.Selected, SelectedOK: b.SelectedOK, ScoreCalls: b.ScoreCalls,
				Tolerance: b.Tolerance, Denominator: b.Denominator}
			receipt.OrdinalAvailable = b.Available
			if b.SelectedOK {
				proposals = []correctionflow.FrequencyProposal{b.Selected}
			}
		} else if r.method.prepared.Plan.SchemaVersion == 2 {
			assess := correctionflow.AssessSelectiveFrequencyProposals
			if replayCrowdingNarrow {
				assess = correctionflow.AssessReplayWinnerSeparated
			}
			selective := assess(evidence.Key, subject, s.Frequency, outcome.Selection, sources, r.cfg.CallCorrection, options)
			receipt.Assessment, receipt.SelectiveDeclines = selective.FrequencyAssessment, selective.Declines
			proposals = receipt.Assessment.Proposals
		} else {
			receipt.Assessment = correctionflow.AssessFrequencyProposals(evidence.Key, subject, s.Frequency, outcome.Selection, sources, r.cfg.CallCorrection, options)
			proposals = receipt.Assessment.Proposals
		}
		if permitted != "" {
			// Apply the existing release identity after B's full-population winner
			// selection. Never promote a permitted runner-up by pruning opponents.
			var eligible []correctionflow.FrequencyProposal
			for _, p := range proposals {
				if p.Identity == spot.CorrectionVoteKey(permitted) {
					eligible = append(eligible, p)
				}
			}
			proposals = eligible
			if compatibility && receipt.Compatibility.SelectedOK && len(proposals) == 0 {
				outcome.methodReason = "compatibility_temporal_identity"
			}
		}
		if candidate.Ranking == "ordinal" {
			proposals, receipt.OrdinalAvailable = r.method.prepared.Model.RankFrequencyProposals(proposals, spot.CorrectionVoteKey(subject), evidence.Key.Mode, evidence.Report, evidence.HasReport)
		}
		// All proposals use the same associated evidence population. Two
		// original-call reporters are also C's existing rival credibility floor.
		if replayCrowdingNarrow && len(proposals) > 0 && proposals[0].SubjectSupport >= 2 {
			receipt.Assessment.Reason = "crowding_original_supported"
			proposals = nil
		}
		for _, proposal := range proposals[:min(8, len(proposals))] {
			gate := r.evaluateMethodGate(s, subject, proposal, now)
			receipt.Trials = append(receipt.Trials, studyMethodGateTrial{proposal, gate})
			outcome.Gate, outcome.GateEvaluated = gate, true
			if !gate.Allow {
				continue
			}
			if r.vetoBurstV16(s, subject, proposal.Call) {
				outcome.methodReason = "v16_burst_veto"
				break // Keep the incoming spelling on a veto.
			}
			outcome.methodWinner = proposal.Call
			applied, suppress, reason := applyReplayReplacement(s, proposal.Call, r.cfg.CallCorrection, r.ctyDB, now)
			outcome.Applied, outcome.Suppress, outcome.replacementRejected = applied, suppress, !applied
			outcome.Confidence.Final = normalizeConfidenceGlyph(s.Confidence)
			if applied {
				outcome.Winner = proposal.Call
				if r.method.prepared.Plan.SchemaVersion == 2 {
					s.ConfidencePercent, s.ConfidencePercentOK = correctionflow.ResolverCallConfidencePercent(outcome.Selection.Snapshot, proposal.Call)
				}
				if r.tracker != nil {
					r.tracker.IncrementCallCorrections()
				}
				outcome.methodReason = "frequency_applied"
			} else {
				outcome.methodReason = "frequency_" + reason
			}
			break // First gate allowance alone crosses the final validation boundary.
		}
	}
	if outcome.methodReason == "" {
		outcome.methodReason = "frequency_" + receipt.Assessment.Reason
		if receipt.Compatibility != nil {
			outcome.methodReason = "compatibility_" + receipt.Compatibility.Reason
		}
		if len(receipt.Trials) > 0 {
			outcome.methodReason = "frequency_gate_" + outcome.Gate.Reason
		}
	}
	receipt.Applied, receipt.Suppress, receipt.ReplacementRejected = outcome.Applied, outcome.Suppress, outcome.replacementRejected
	receipt.FinalObserved = normalizedDXCall(s)
	receipt.OrdinaryPublicPercent, receipt.OrdinaryPublicPercentPresent = correctionflow.ResolverCallConfidencePercent(outcome.Selection.Snapshot, receipt.FinalObserved)
	// Full terminal output is retained. Only non-action method diagnostics
	// are sampled, to preserve the four-GiB bound on the largest archive days.
	if _, tracked := replayCrowdingAnchors[receipt.RawID]; tracked || len(receipt.Trials) > 0 || receipt.Assessment.Reason == "crowding_original_supported" {
		if err := r.method.record(receipt); err != nil {
			r.method.files.latch(err)
		}
	}
	return outcome
}

func (r *replayRunner) evaluateMethodGate(s *spot.Spot, subject string, p correctionflow.FrequencyProposal, now time.Time) spot.ResolverPrimaryGateResult {
	cfg := r.cfg.CallCorrection
	runtime := correctionflow.ResolveRuntimeSettings(cfg, s, r.adaptiveMinReports, now, false)
	settings := correctionflow.BuildCorrectionSettings(correctionflow.BuildSettingsInput{Cfg: cfg, MinReports: runtime.MinReports, Window: runtime.Window,
		FreqToleranceHz: runtime.FreqToleranceHz, RecentBandStore: r.recentBandStore})
	band, mode := s.BandNorm, s.ModeNorm
	if band == "" || band == "???" {
		band = spot.FreqToBand(s.Frequency)
	}
	if mode == "" {
		mode = s.Mode
	}
	options := spot.ResolverPrimaryGateOptions{}
	// Preserve V1's frozen replay contract. New V2 consumers use the complete
	// ordinary comparator restriction, including structurally enabled Bayes.
	comparatorEnabled := cfg.ResolverRecentPlus1Enabled
	if r.method != nil && r.method.prepared.Plan.SchemaVersion == 2 {
		comparatorEnabled = comparatorEnabled || config.BayesBonusModeEnabled(cfg.BayesBonus.Enabled, cfg.BayesBonus.EnabledDistancesByMode, mode, cfg.MaxEditDistance)
	}
	if comparatorEnabled && p.ComparableEditNeighbor {
		options.RecentPlus1DisallowReason = resolverRecentPlus1DisallowEditNeighborGate
	}
	return spot.EvaluateResolverPrimaryGates(subject, p.Call, band, mode, p.SubjectSupport, p.Support, p.ConfidencePercent,
		p.SubjectWeightedSupportMilli, p.WeightedSupportMilli, settings, now, options)
}

// Two independent receiver-family reports corroborate a spelling. Keep only the
// latest eligible first report per closing report: that representative maximizes
// the tie-break and admits every possible earlier opposite-side burst.
type burstRowV16 struct {
	sec, ordinal int64
	family       string
	speed        int
}
type burstPairV16 struct{ first, last burstRowV16 }

func candidatePairsV16(rows []burstRowV16) []burstPairV16 {
	var pairs []burstPairV16
	var newest, alternate burstRowV16
	for _, last := range rows {
		// Maintain the latest observation from each of the two most recent
		// distinct families. Older first reports cannot improve chronology.
		first := newest
		if first.family == last.family {
			first = alternate
		}
		if first.family != "" && last.sec-first.sec <= 3 {
			pairs = append(pairs, burstPairV16{first, last})
		}
		if newest.family != last.family {
			alternate = newest
		}
		newest = last
	}
	return pairs
}

// Times are archive-ordered with ordinal breaking ties. For each orientation,
// pick the latest valid closing pair, then the latest opposite predecessor.
func latestSerialV16(older, newer []burstPairV16) (burstPairV16, burstPairV16, bool) {
	for j := len(newer) - 1; j >= 0; j-- {
		q := newer[j]
		i := sort.Search(len(older), func(i int) bool { return older[i].last.sec+3 >= q.first.sec }) - 1
		if i >= 0 {
			return older[i], q, true
		}
	}
	return burstPairV16{}, burstPairV16{}, false
}
func pairSumV16(p burstPairV16) (int, bool) {
	return p.first.speed + p.last.speed, p.first.speed > 0 && p.last.speed > 0 && math.Abs(float64(p.first.speed-p.last.speed)) <= 2
}
func supportsOriginalV16(original, other []burstRowV16, speed int, useSpeed bool) bool {
	a, b := candidatePairsV16(original), candidatePairsV16(other)
	first, last, originalLast := latestSerialV16(b, a)
	if !originalLast {
		return false
	}
	_, otherLast, hasOther := latestSerialV16(a, b)
	if hasOther && otherLast.last.ordinal > last.last.ordinal {
		return false
	}
	if !useSpeed {
		return true
	}
	o, goodO := pairSumV16(last)
	c, goodC := pairSumV16(first)
	d1, d2 := math.Abs(float64(2*speed-o)), math.Abs(float64(2*speed-c))
	return speed > 0 && goodO && goodC && math.Abs(float64(o-c)) >= 8 && d1 <= 4 && d1+4 <= d2
}

var burstRuleV16 = os.Getenv("GOCLUSTER_V16_BURST")

func (r *replayRunner) vetoBurstV16(s *spot.Spot, subject, winner string) bool {
	if burstRuleV16 == "" || r.study == nil {
		return false
	}
	if burstRuleV16 != "clock" && burstRuleV16 != "speed" {
		panic("invalid v16 burst rule")
	}
	pending := r.study.pending[s]
	if pending == nil {
		return false
	}
	day := r.study.day
	focal := day.Rows[pending.Ordinal-1]
	if !studyFocalRow(focal) || focal.Row.Mode != "CW" || focal.Row.DXCall != subject || subject == winner {
		return false
	}
	idx := day.Index[focal.Row.Band+"\x00CW"]
	sec := focal.Row.Time.Unix()
	start := sort.Search(len(idx), func(i int) bool { return day.Rows[idx[i]].Row.Time.Unix() >= sec-300 })
	var original, other []burstRowV16
	freq := math.Round(focal.Row.FreqKHz * 1000)
	for _, j := range idx[start:] {
		raw := &day.Rows[j]
		if raw.Ordinal >= focal.Ordinal || raw.Row.Time.After(focal.Row.Time) {
			break
		}
		if !raw.A || raw.Family == focal.Family || math.Abs(math.Round(raw.Row.FreqKHz*1000)-freq) > 300 {
			continue
		}
		obs := burstRowV16{raw.Row.Time.Unix(), raw.Ordinal, raw.Family, raw.Row.v16Speed}
		switch raw.Row.DXCall {
		case subject:
			original = append(original, obs)
		case winner:
			other = append(other, obs)
		}
	}
	return supportsOriginalV16(original, other, focal.Row.v16Speed, burstRuleV16 == "speed")
}
